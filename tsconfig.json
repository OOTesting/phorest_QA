{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",

    "types": ["node", "playwright"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "allowJs": false,
    "isolatedModules": true,
    "skipLibCheck": true,

    "outDir": "dist"
  },

  "include": [
    "./tests/**/*",
    "./pages/**/*",
    "./helpers/**/*",
    "./global-setup.ts",
    "./global-teardown.ts",
    "./playwright.config.ts"
  ]
}
